# Content search uses its own VL model, independent of the shell assistant.
CONTENT_VL_BASE_URL=http://127.0.0.1:11434/v1
CONTENT_VL_MODEL=qwen2.5vl:7b
CONTENT_VL_API_KEY=ollama
CONTENT_TIMEOUT=180

# FlagEmbedding provides BGE-M3 dense+sparse hybrid retrieval.
CONTENT_EMBEDDING_BACKEND=flagembedding
CONTENT_EMBEDDING_MODEL=BAAI/bge-m3
CONTENT_EMBEDDING_DEVICE=cpu
# For Ollama dense-only mode, use backend=ollama and model=bge-m3.
CONTENT_OLLAMA_URL=http://127.0.0.1:11434

# Empty URL uses a persistent embedded Qdrant under work/.content-index/qdrant.
CONTENT_QDRANT_URL=
CONTENT_QDRANT_API_KEY=
# CONTENT_QDRANT_PATH=/absolute/path/to/qdrant-data
# CONTENT_COLLECTION=samantha_content_flagembedding_v1
CONTENT_CHUNK_SIZE=1200
CONTENT_CHUNK_OVERLAP=150
CONTENT_BATCH_SIZE=8
# auto: scans and pages containing raster/vector graphics; always: every page.
CONTENT_PDF_VISION=auto

# Optional persistent interaction log path. Default: work/.samantha/interactions.sqlite3.
# For Docker, choose a path inside /work so the host bind mount retains it.
# SAMANTHA_LOG_PATH=/work/.samantha/interactions.sqlite3
# Log reasoning only when the model API returns it; does not enable model thinking.
SAMANTHA_LOG_REASONING=true
