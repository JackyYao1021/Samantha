# Shell workflow and independent command reviewer share the local Qwen backend.
# Defaults already target Ollama qwen3:4b; uncomment to override for host runs.
# QWEN_BASE_URL=http://127.0.0.1:11434/v1
# QWEN_MODEL=qwen3:4b
# QWEN_API_MODE=ollama
# QWEN_TIMEOUT=120
# Reviewer never falls back to Azure, even if other agents enable that fallback.

# Content search uses its own VL model, independent of the shell assistant.
CONTENT_VL_BASE_URL=http://127.0.0.1:11434/v1
CONTENT_VL_MODEL=qwen2.5vl:7b
CONTENT_VL_API_KEY=ollama
CONTENT_TIMEOUT=180

# FlagEmbedding provides BGE-M3 dense+sparse hybrid retrieval.
CONTENT_EMBEDDING_BACKEND=flagembedding
CONTENT_EMBEDDING_MODEL=BAAI/bge-m3
CONTENT_EMBEDDING_DEVICE=cpu
# For Ollama dense-only mode, use backend=ollama and model=bge-m3.
CONTENT_OLLAMA_URL=http://127.0.0.1:11434

# Empty URL uses a persistent embedded Qdrant under work/.content-index/qdrant.
CONTENT_QDRANT_URL=
CONTENT_QDRANT_API_KEY=
# CONTENT_QDRANT_PATH=/absolute/path/to/qdrant-data
# CONTENT_COLLECTION=samantha_content_flagembedding_v1
CONTENT_CHUNK_SIZE=1200
CONTENT_CHUNK_OVERLAP=150
CONTENT_BATCH_SIZE=8
# auto: scans and pages containing raster/vector graphics; always: every page.
CONTENT_PDF_VISION=auto

# Optional persistent interaction log path. Default: work/.samantha/interactions.sqlite3.
# For Docker, choose a path inside /work so the host bind mount retains it.
# SAMANTHA_LOG_PATH=/work/.samantha/interactions.sqlite3
# Log reasoning only when the model API returns it; does not enable model thinking.
SAMANTHA_LOG_REASONING=true

# Agent memory experiments are opt-in; default none preserves the existing workflow.
# SAMANTHA_MEMORY_BACKEND=recent
# Available built-ins: none, recent, bm25. External adapters: package.module:factory.
# SAMANTHA_MEMORY_PATH=/work/.samantha/memory.sqlite3
# Keep a stable project ID when navigating between folders in the same project.
# SAMANTHA_MEMORY_USER=local
# SAMANTHA_MEMORY_PROJECT=samantha-demo
# Limit is sessions for built-ins; budget measures serialized Unicode characters.
# SAMANTHA_MEMORY_LIMIT=5
# SAMANTHA_MEMORY_BUDGET=6000

# P0 verified file objects are independent of raw-history memory and opt-in.
# Supports one controlled create/rename/append operation per invocation.
# SAMANTHA_OBJECT_TRACKING=true
# SAMANTHA_OBJECT_PATH=/work/.samantha/objects.sqlite3
# Stable project is required (SAMANTHA_MEMORY_PROJECT can also supply it).
# SAMANTHA_OBJECT_PROJECT=samantha-demo
# SAMANTHA_OBJECT_USER=local
